.ix-table th.dsc::after { content: ' ↓'; color: var(--signal-500); }
.ix-table td { padding: 12px 14px; border-bottom: 1px solid var(--line-rule); vertical-align: top; }
.ix-table tr:last-child td { border-bottom: none; }
