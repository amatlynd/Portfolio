/* ── ABOUT VIEW ───────────────────────────────────────── */
#view-about {
  position: fixed; inset: var(--top-bar) 0 0 0;
  overflow-y: auto;
  padding: 60px 32px 100px;
}
.ab-inner { max-width: 820px; margin: 0 auto; }
.ab-eyebrow {
  font-family: 'JetBrains Mono', monospace; font-size: var(--text-xs);
  color: var(--text-faint); letter-spacing: var(--track-label); text-transform: uppercase;
  margin-bottom: 10px; display: flex; align-items: center; gap: 10px;
}
.ab-eyebrow::after { content: ''; flex: 1; height: 1px; background: var(--line-rule); max-width: 60px; }
