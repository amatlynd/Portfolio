<!-- ── SCRIPT ─────────────────────────────────────────────────────────── -->
<script is:inline>
(function () {
  var PINS = [
    { ref: 'B-12', x: 600, y: 168, stack: ['Flutter','Dart','Firebase','Riverpod'] },
    { ref: 'C-19', x: 936, y: 456, stack: ['Astro','TypeScript','CSS','GitHub Actions'] },
  ];
  var GW = 1440, GH = 960;

  // ── THEME ──────────────────────────────────────────────
  var R = document.documentElement;
  var tBtn = document.getElementById('theme-btn');
  var iSun = document.getElementById('ico-sun');
  var iMoon = document.getElementById('ico-moon');

  // SVGElement has no `hidden` IDL property, so toggle the attribute directly.
  function setIcons(eff) {
    iSun.toggleAttribute('hidden', eff === 'light');
    iMoon.toggleAttribute('hidden', eff === 'dark');
  }

  function applyTheme(t) {
    R.setAttribute('data-theme', t);
    setIcons(t);
    tBtn.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    try { localStorage.setItem('theme', t); } catch(e) {}
  }

  // Sync icons with whatever theme is already active (set before first paint).
  (function syncIcons() {
    var cur = R.getAttribute('data-theme');
    var sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    setIcons(cur || sys);
  })();

  tBtn.addEventListener('click', function () {
    var cur = R.getAttribute('data-theme');
    var sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    applyTheme((cur || sys) === 'dark' ? 'light' : 'dark');
  });

  // ── VIEW SWITCH ────────────────────────────────────────
  var viewConfig = {
    canvas: { btn: document.getElementById('btn-c'), el: document.getElementById('view-canvas') },
    index:  { btn: document.getElementById('btn-i'), el: document.getElementById('view-index') },
    about:  { btn: document.getElementById('btn-a'), el: document.getElementById('view-about') },
  };
  var legend   = document.getElementById('legend');
  var minimap  = document.getElementById('minimap');
  var announce = document.getElementById('announce');
  var curView  = 'canvas';

  function switchView(v) {
    if (v === curView) return;
    curView = v;
    Object.keys(viewConfig).forEach(function (k) {
      var o = viewConfig[k];
      var on = (k === v);
      o.btn.classList.toggle('on', on);
      o.btn.setAttribute('aria-selected', on ? 'true' : 'false');
      o.el.hidden = !on;
    });
    legend.hidden  = (v !== 'canvas');
    minimap.hidden = (v !== 'canvas');
    announce.textContent = 'Switched to ' + v + ' view';
    viewConfig[v].el.focus();
  }

  Object.keys(viewConfig).forEach(function (n) {
    viewConfig[n].btn.addEventListener('click', function () { switchView(n); });
  });

  // ── KEYBOARD ───────────────────────────────────────────
  var viewOrder = ['canvas', 'index', 'about'];
  document.addEventListener('keydown', function (e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'v' || e.key === 'V') {
      switchView(viewOrder[(viewOrder.indexOf(curView) + 1) % viewOrder.length]);
    }
    if (e.key === '/' && curView === 'canvas') {
      e.preventDefault();
      var first = document.querySelector('.leg-tag');
      if (first) first.focus();
    }
    if (e.key === 'Escape') clearFilter();
  });

  // ── LEGEND / FILTER ────────────────────────────────────
  var legTags  = document.querySelectorAll('.leg-tag');
  var legClear = document.getElementById('leg-clear');
  var allPins  = document.querySelectorAll('.pin');
  var activeF  = null;

  legTags.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var f = btn.dataset.f;
      if (activeF === f) { clearFilter(); return; }
      activeF = f;
      legTags.forEach(function (b) { b.classList.toggle('on', b.dataset.f === f); });
      allPins.forEach(function (p) {
        var s = (p.dataset.stack || '').split(',');
        p.classList.toggle('dim', s.indexOf(f) === -1);
      });
      legClear.classList.add('show');
    });
  });

  legClear.addEventListener('click', clearFilter);

  function clearFilter() {
    activeF = null;
    legTags.forEach(function (b) { b.classList.remove('on'); });
    allPins.forEach(function (p) { p.classList.remove('dim'); });
    legClear.classList.remove('show');
  }

  // ── COORD CHIP ─────────────────────────────────────────
  var coordEl = document.getElementById('coord');
  allPins.forEach(function (p) {
    p.addEventListener('mouseenter', function () { coordEl.textContent = p.dataset.ref; });
  });

  // ── MINIMAP ────────────────────────────────────────────
  var mmPlot  = document.getElementById('mm-plot');
  var mmVP    = document.getElementById('mm-vp');
  var canvas  = document.getElementById('view-canvas');

  PINS.forEach(function (d) {
    var dot = document.createElement('div');
    dot.className = 'mm-dot';
    dot.style.left = (d.x / GW * 100) + '%';
    dot.style.top  = (d.y / GH * 100) + '%';
    mmPlot.insertBefore(dot, mmVP);
  });

  function updateMM() {
    var cw = canvas.clientWidth, ch = canvas.clientHeight;
    var sx = canvas.scrollLeft,  sy = canvas.scrollTop;
    var gw = Math.max(cw, GW),   gh = Math.max(ch, GH);
    mmVP.style.left   = (sx / gw * 100) + '%';
    mmVP.style.top    = (sy / gh * 100) + '%';
    mmVP.style.width  = (cw / gw * 100) + '%';
    mmVP.style.height = (ch / gh * 100) + '%';
  }

  canvas.addEventListener('scroll', updateMM, { passive: true });
  window.addEventListener('resize', updateMM, { passive: true });
  updateMM();

  // ── INDEX SORT ─────────────────────────────────────────
  var ixBody = document.getElementById('ix-body');
  var colKeys = ['ref','title','desc','stack','year','status'];

  document.querySelectorAll('.ix-table th[data-col]').forEach(function (th) {
    var sDir = 'asc';
    th.addEventListener('click', function () {
      document.querySelectorAll('.ix-table th').forEach(function (t) { t.classList.remove('asc','dsc'); });
      sDir = (sDir === 'asc') ? 'dsc' : 'asc';
      th.classList.add(sDir);
      var ci = colKeys.indexOf(th.dataset.col);
      var rows = Array.from(ixBody.querySelectorAll('tr'));
      rows.sort(function (a, b) {
        var av = (a.querySelectorAll('td')[ci] || {}).textContent.trim().toLowerCase();
        var bv = (b.querySelectorAll('td')[ci] || {}).textContent.trim().toLowerCase();
        if (!isNaN(av) && !isNaN(bv)) { av = +av; bv = +bv; }
        return (sDir === 'asc' ? 1 : -1) * (av < bv ? -1 : av > bv ? 1 : 0);
      });
      rows.forEach(function (r) { ixBody.appendChild(r); });
    });
  });

})();
</script>

