.td-ref { font-family: 'JetBrains Mono', monospace; font-size: var(--text-xs); font-weight: 500; color: var(--signal-500); letter-spacing: var(--track-label); white-space: nowrap; }
.td-title { font-weight: 600; white-space: nowrap; }
.td-desc { font-family: 'Newsreader', Georgia, serif; font-size: 13px; color: var(--text-secondary); font-style: italic; line-height: 1.5; max-width: 36ch; }
